{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "rm -rf dist && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "pnpm run dev:kill-port && pnpm run build && concurrently -k -n TSC,APP -c yellow,cyan \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"nodemon --watch dist --ext js --delay 200ms --exec node dist/main.js\"",
    "start": "nest start",
    "start:dev": "pnpm run dev:kill-port && pnpm run build && concurrently -k -n TSC,APP -c yellow,cyan \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"nodemon --watch dist --ext js --delay 200ms --exec node dist/main.js\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prestart:prod": "pnpm run build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "sequelize:migrate": "sequelize-cli db:migrate",
    "sequelize:migrate:undo": "sequelize-cli db:migrate:undo",
    "sequelize:seed": "sequelize-cli db:seed:all",
    "sequelize:seed:undo": "sequelize-cli db:seed:undo:all",
    "kb:eval-extraction": "ts-node -r dotenv/config scripts/kb-eval-extraction.ts dotenv_config_path=../../.env",
    "dev:kill-port": "lsof -ti tcp:3000 | xargs kill -9 2>/dev/null || true"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-ws": "^11.0.1",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/websockets": "^11.0.1",
    "bullmq": "^6.0.2",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
