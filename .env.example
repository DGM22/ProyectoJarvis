# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Knowledge Base (set KB_EXTRACTION_ENABLED=true only after kb:eval-extraction)
# KB_EXTRACTION_ENABLED=false

# Postgres (docker-compose + Sequelize)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secret
POSTGRES_DB=jarvis

# Backend
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Mexico_City

# Google OAuth (Calendar + Tasks + Gmail + Drive)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/google/auth/callback
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3000

# Wake word (Python openWakeWord — docker compose service `wakeword`)
WAKEWORD_SERVICE_URL=ws://localhost:8765
WAKEWORD_WS_TOKEN=
WAKEWORD_PORT=8765
WAKEWORD_THRESHOLD=0.5
