# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Postgres (docker-compose + Sequelize)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secret
POSTGRES_DB=jarvis

# Backend
BACKEND_PORT=3000
# Orígenes permitidos por CORS, separados por coma.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
APP_TIMEZONE=America/Mexico_City

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3000

# Wake word (Python openWakeWord — docker compose service `wakeword`)
WAKEWORD_SERVICE_URL=ws://localhost:8765
WAKEWORD_WS_TOKEN=
WAKEWORD_PORT=8765
WAKEWORD_THRESHOLD=0.5

# Verificación facial del dueño en el timbre (AWS Rekognition CompareFaces).
# Sin AWS_REGION queda deshabilitada. Usa un usuario IAM con solo
# rekognition:CompareFaces, o un rol de instancia en lugar de llaves.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FACE_MATCH_THRESHOLD=90
# Con "match" el ESP32 mueve el servo de la puerta y lo regresa tras este tiempo.
DOOR_OPEN_MS=5000

# Login (cookie de sesión firmada). Genera uno: openssl rand -hex 32
AUTH_SECRET=
AUTH_SESSION_DAYS=30

# Usuario de prueba creado por el seed en cada docker compose up (mín. 8 caracteres)
SEED_TEST_USERNAME=prueba
SEED_TEST_PASSWORD=
